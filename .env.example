# ===== Browser-exposed keys (restrict by HTTP referrer in Google Cloud Console) =====
# Google Places API (New) — used by the address autocomplete on the landing page.
# Enable "Places API (New)" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Contact phone shown in the site header (optional — omit to hide the phone link).
# Use format: (02) 9123 4567
NEXT_PUBLIC_CONTACT_PHONE=

# Hostname that serves the operator CRM. Requests arriving on this host are
# routed to src/app/crm; everything else gets the public site.
# "app.localhost" always works for local dev regardless of this value.
NEXT_PUBLIC_APP_HOST=app.roofing.sydney

# Public site origin. Quote portal links in client emails are built from this —
# a homeowner should land on roofing.sydney/q/…, not on the back office's
# hostname. Middleware serves /q/* on both hosts, so this is purely a choice
# about what the customer sees.
NEXT_PUBLIC_SITE_URL=https://roofing.sydney

# Loopback port the container publishes. nginx proxies app.roofing.sydney here.
# Verify nothing else holds it before wiring nginx: sudo ss -ltnp | grep 9030
APP_PORT=9030

# ===== Server-only keys (never prefix with NEXT_PUBLIC_) =====
#
# ⚠ Docker: NEXT_PUBLIC_* above are inlined into the client and middleware
# bundles at BUILD time and must be passed as build args. Everything below is
# runtime-only and must NEVER be a build arg — a build arg is recoverable from
# the image's layer history.

# --- Aerial tiles ---
# Which provider /api/tiles proxies to: "mapbox" (free tier, default) or "nearmap" (paid).
TILE_PROVIDER=mapbox
# Required if TILE_PROVIDER=mapbox. Get one at https://account.mapbox.com/access-tokens/
# A default public token (pk.…) works; for production restrict by URL.
MAPBOX_ACCESS_TOKEN=
# Required if TILE_PROVIDER=nearmap.
NEARMAP_API_KEY=

# --- Roof segmentation ---
# Replicate — used by meta/sam-2 for roof segmentation. ~$0.007 per click.
REPLICATE_API_TOKEN=

# --- Lead storage (Supabase) ---
# Create a free project at https://supabase.com. Run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contractor notifications + quote email (Resend) ---
# Sign up at https://resend.com. For the free tier, the `from` must be
# onboarding@resend.dev until you verify your domain. The same sender is used
# for lead alerts and for quotes going out to clients, so verify the domain
# before the first real quote is issued — a quote from onboarding@resend.dev
# will not read as coming from the business.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=onboarding@resend.dev
CONTRACTOR_NOTIFICATION_EMAIL=

# --- Payments (Stripe, phase 8 — optional) ---
# Leave blank to run without the money column: invoices still record manual
# payments, only the card-payment link is unavailable. AU account, AUD.
# Amounts are sent in minor units (cents), matching how they are stored.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook rejects every delivery, which is the correct
# failure — an unverified payload must never mark an invoice paid.
STRIPE_WEBHOOK_SECRET=
